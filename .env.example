# Copy this file to .env and change values when needed.

APP_NAME=course-rag-agent

# Storage
CHROMA_DIR=storage/chroma
BM25_INDEX_PATH=storage/bm25/index.pkl
COLLECTION_NAME=course_materials

# Embedding
# Recommended local model: BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
ALLOW_HASH_EMBEDDING_FALLBACK=true
HASH_EMBEDDING_DIM=384

# Chunking
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5
CANDIDATE_K=20
VECTOR_WEIGHT=0.65
SCORE_THRESHOLD=0.25
MAX_RETRIES=2

# OpenAI-compatible LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
